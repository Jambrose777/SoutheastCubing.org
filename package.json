{
  "name": "southeastcubing-org",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  },
  "lint-staged": {
    "*.{ts,js,html,scss,json,md}": [
      "node scripts/check-no-story-refs.js"
    ],
    "*.{ts,html,scss,json,md}": [
      "prettier --write"
    ],
    "frontend/src/**/*.{ts,html}": [
      "eslint --fix"
    ],
    "backend/**/*.js": [
      "eslint --fix"
    ]
  }
}
