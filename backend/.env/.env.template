# Comma-separated list of origins allowed to make cross-origin requests to this API.
CORS_ORIGIN="http://localhost:4200"

# Dev Aurora DSQL cluster endpoint the backend connects to via backend/app/database/pool.js,
# using the AWS credentials below for IAM token auth (no database password).
DSQL_ENDPOINT=""

# IAM user/role ARN granted the ability to connect as the app_dev database role.
# Only needed when running `pnpm --filter backend bootstrap-dsql-role` (see
# backend/scripts/bootstrap-dsql-role.js) - not read by the running backend.
DSQL_GRANT_IAM_ARN=""

# AWS IAM access key/secret for a local-dev-only IAM user - used above for Aurora
# DSQL IAM token signing.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Contentful space ID and Content Delivery API access token for the Southeast Cubing
# space. Find them under Contentful > Settings > API keys.
CONTENTFUL_SPACE=""
CONTENTFUL_ACCESS_TOKEN=""

# A webhook URL on a personal/test Discord server you control, so local competition
# announcements never post into the real Southeast Cubing server. Create a server,
# then Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL.
DISCORD_WEBHOOK=""

# Gmail account to send outgoing mail from.
# A Gmail "App Password" for EMAIL_USER (not the account's normal login password).
# Generate one at https://myaccount.google.com/apppasswords while signed into your
# personal account (requires 2-Step Verification enabled).
EMAIL_USER=""
EMAIL_PASS=""

# Recipient for the "organizing" contact-form category
EMAIL_TO_COMPETITIONS=""
# Recipient for every category that isn't backed by a team, plus the
# fallback if a team-backed category's team has no email set.
EMAIL_TO_CONTACT=""

# Your own base email address - every send call site outside production sends
# emails to this address.
DEV_EMAIL_OVERRIDE=""

# Dev-only "login as" role impersonation - lets you sign in as a specific role
# through the header's role picker without a separate real WCA account per role. 
# Only ever set locally - never set this in a deployed environment. Set to "true" 
# to enable; leave unset to disable.
ALLOW_DEV_ROLE_IMPERSONATION=""

# Optional Fields with default values provided by the backend if unset

# WCA OAuth (Doorkeeper) app credentials for "Sign in with WCA" - register an app at
# https://www.worldcubeassociation.org/users/edit#oauth-applications with this
# redirect URI, requesting the "public email, dob, and manage_competitions" scope.
WCA_OAUTH_CLIENT_ID=""
WCA_OAUTH_CLIENT_SECRET=""
WCA_OAUTH_REDIRECT_URI="http://localhost:8080/auth/wca/callback"

# Base URL of the frontend - the backend redirects here once the
# WCA OAuth handshake completes (success or deny).
FRONTEND_URL="http://localhost:4200"

# Domain scope for the session cookie - leave unset locally so the cookie is
# host-only. Production sets this to ".southeastcubing.org".
# SESSION_COOKIE_DOMAIN=""

# Controls log verbosity - "development" logs at debug level, "production" logs
# at info level (quieter). Unset is treated the same as "development".
NODE_ENV="development"

# Explicit override of the log level NODE_ENV would otherwise pick - leave commented
# out to use the NODE_ENV default. Set to "trace" to see raw parameterized query text
# logged from backend/app/database/pool.js (never the bound values themselves).
# LOG_LEVEL="trace"
